{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    // "baseUrl": ".",
    "outDir": "dist",
    // Renamed from "node"; deprecated and slated for removal in TS 7. Moving to
    // "bundler" would require module: esnext/preserve, which would break
    // ts-node loading forge.config.ts, so it stays until that is untangled.
    "moduleResolution": "node10",
    "resolveJsonModule": true,
    "jsx": "react"
  },
  // electron-forge loads forge.config.ts through ts-node/register, which type-checks
  // it on every `start`/`package`/`make`. Transpile-only keeps the build decoupled
  // from type errors in that graph — node10 resolution cannot see "exports"-only
  // packages, so those would otherwise become startup failures rather than warnings.
  "ts-node": {
    "transpileOnly": true
  }
}
