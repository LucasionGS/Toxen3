    "@tabler/icons-react": "^3.5.0",
    "animejs": "^3.2.2",
    "archiver": "^7.0.1",
    "bootstrap": "^5.3.3",
    "cross-fetch": "^4.0.0",
    "discord-rpc": "^4.0.1",
