{
  "name": "toxen3",
  "productName": "Toxen",
  "version": "2.10.0",
  "description": "Toxen Music Player",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "start:dev": "electron-forge start -- --dev",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "buildweb": "vite build --config ./vite.web.config.ts",
    "startweb": "vite --config ./vite.web.config.ts",
    "setupdate": "node setupdate.js",
    "generate:srcinfo": "makepkg --printsrcinfo > .SRCINFO",
    "clean:arch": "rm -rf pkg src/Toxen3-* src/toxen3-*.tar.gz toxen3-*.tar.gz *.pkg.tar.zst"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
